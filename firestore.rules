rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin registry: only manageable directly in Firebase Console
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // User profiles: private to owner (or admin). Rank and immutable IDs are protected.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.firebase_uid == uid
        && request.resource.data.minecraft_uuid is string
        && request.resource.data.minecraft_uuid.size() == 32
        && (!('rank' in request.resource.data) || request.resource.data.rank == 'default')
        && request.resource.data.redsouth_username is string
        && request.resource.data.redsouth_username.matches('^[a-zA-Z0-9_]{3,16}$')
        && request.resource.data.redsouth_username_lower == request.resource.data.redsouth_username.lower()
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,16}$')
        && request.resource.data.username_lower == request.resource.data.username.lower()
      );

      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.firebase_uid == resource.data.firebase_uid
        && request.resource.data.minecraft_uuid == resource.data.minecraft_uuid
        && request.resource.data.get('rank', 'default') == resource.data.get('rank', 'default')
        && request.resource.data.redsouth_username is string
        && request.resource.data.redsouth_username.matches('^[a-zA-Z0-9_]{3,16}$')
        && request.resource.data.redsouth_username_lower == request.resource.data.redsouth_username.lower()
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,16}$')
        && request.resource.data.username_lower == request.resource.data.username.lower()
      );

      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // Unique REDSOUTH account username reservations
    match /redsouth_usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null
        && usernameLower.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Unique Minecraft username reservations (for ONE Launcher & Skins)
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null
        && usernameLower.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
